    {"name": "last second of the window", "ids": ["CU02"], "steps": [
      {"event": {"id": "nc.r1.A", "state": "inside", "at": "2026-11-17T07:59:59+07:00"},
       "expect": {"start": "towardB", "dateKey": "2026-11-17"}}]},
    {"name": "Sunday is not in Monday-Friday", "ids": ["CU03"], "steps": [

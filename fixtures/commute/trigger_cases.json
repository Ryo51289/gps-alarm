    {"name": "window end is exclusive", "ids": ["CU02"], "steps": [
      {"event": {"id": "nc.r1.A", "state": "inside", "at": "2026-11-17T08:00:00+07:00"}, "expect": {"skip": "outsideWindow"}}]},
    {"name": "window start is inclusive", "ids": ["CU02"], "steps": [
      {"event": {"id": "nc.r1.A", "state": "inside", "at": "2026-11-17T07:00:00+07:00"},

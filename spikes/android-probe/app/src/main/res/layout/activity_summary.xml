<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/ProbeSection"
            android:layout_marginTop="0dp"
            android:text="@string/summary_title" />

        <!-- One button per run, newest first -->
        <LinearLayout
            android:id="@+id/runList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/summaryText"
            style="@style/ProbeText"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="@string/summary_pick"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btnShare"
            style="@style/ProbeButton"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/btn_share_summary" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/ProbeButton"
            android:enabled="false"
            android:text="@string/btn_delete_run" />
    </LinearLayout>
</ScrollView>

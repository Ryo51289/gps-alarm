# OS / IDE
.DS_Store
.idea/
.vscode/
*.iml

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/

# Android
local.properties
.gradle/
*.keystore
*.jks
key.properties

# iOS
Pods/
*.xcuserstate
xcuserdata/
# NapStopCore Swift package (T13): build output and SwiftPM state
app/ios/Core/.build/
app/ios/Core/.swiftpm/

# Firebase config is non-secret (T29 1.3, T29.2 D3): the iOS plist is committed; other copies (dist/) and the
# Android file (until T29 step B) stay out of git. Maps keys stay out of git.
google-services.json
GoogleService-Info.plist
!app/ios/Runner/GoogleService-Info.plist
.env*
# Legacy Maps/Places key files (T23), no longer used since T23.2 (ADR-002). Kept so an old copy on a dev machine
# is never committed: app/android/secrets.properties, app/ios/Flutter/Secrets.xcconfig
secrets.properties
Secrets.xcconfig
# CI diagnostics flag for test IPAs (T01.2 D6), written by the ios-device job only
app/ios/Flutter/Diag.xcconfig
# Entrypoints generated by the ios-sim job from integration_test/ios_suite.txt (T01.2)
app/integration_test/ios_group_*_test.dart

# Claude Code local settings
.claude/settings.local.json

# ios-builder (S3): downloaded IPAs; XcodeGen output is generated on the runner
/dist/
spikes/ios-probe/*.xcodeproj/
spikes/ios-probe/ProbeCore/.build/
spikes/ios-probe/ProbeCore/.swiftpm/

# Xcode archives (xtool SDK source; never commit or snapshot)
*.xip

# Office lock files
~$*

# Kotlin Gradle plugin session data (Kotlin 2.x)
app/android/.kotlin/

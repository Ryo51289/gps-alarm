          "sql": "CREATE TABLE IF NOT EXISTS \"saved_places\" (\"slot\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"detail\" TEXT NULL, \"kind\" TEXT NOT NULL, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {

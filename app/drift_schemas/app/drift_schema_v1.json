  "fixed_sql": [
    {
      "name": "trips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trips\" (\"id\" TEXT NOT NULL, \"destination_name\" TEXT NOT NULL, \"destination_detail\" TEXT NULL, \"destination_kind\" TEXT NOT NULL, \"dest_lat\" REAL NOT NULL, \"dest_lng\" REAL NOT NULL, \"dest_source\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"distance_threshold_m\" INTEGER NULL, \"time_threshold_min\" INTEGER NULL, \"pre_alert_enabled\" INTEGER NOT NULL CHECK (\"pre_alert_enabled\" IN (0, 1)), \"vehicle_hint\" TEXT NOT NULL, \"simulated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"simulated\" IN (0, 1)), \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"result\" TEXT NULL, \"end_reason\" TEXT NULL, \"alarm_at\" INTEGER NULL, \"alarm_reason\" TEXT NULL, \"dismissed_at\" INTEGER NULL, \"snooze_count\" INTEGER NOT NULL DEFAULT 0, \"travelled_m\" INTEGER NULL, \"vehicle_guess\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },

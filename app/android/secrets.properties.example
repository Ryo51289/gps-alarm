# Copy to app/android/secrets.properties (gitignored, never commit it) and put the
# Google Maps Platform keys of each flavor there (T23 D2/D3). One key per platform,
# restricted to the Android app (package + SHA-1) and to Maps SDK for Android +
# Places API (New). Alternatively set NAPSTOP_MAPS_API_KEY_DEV / _PROD in the
# environment. Without a key the build still works: no map, no address search.
MAPS_API_KEY_DEV=DEFAULT_API_KEY
MAPS_API_KEY_PROD=DEFAULT_API_KEY

<?xml version="1.0" encoding="utf-8"?>
<!-- T16 §5.8: native alarm screen (screen 5 ARRIVING / screen 8 OVERSHOOT while ringing).
     In a ScrollView so 200 % font scale never clips (A-14). Texts are set from code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <View
            android:id="@+id/alarm_glow"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/alarm_overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textColor="@color/alarm_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/alarm_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/alarm_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/alarm_past"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/alarm_text_secondary"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alarm_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@color/alarm_track"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/alarm_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/alarm_route_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="56dp"
            android:textAllCaps="false"
            android:textColor="@color/alarm_bg"
            android:textSize="17sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/alarm_dismiss_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp" />

        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:textAllCaps="false"
            android:textColor="@color/alarm_text"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup rules (T22 D5). The app database holds
     destination coordinates: keep it out of Google Drive backup and out of
     device-to-device transfer. getApplicationSupportDirectory() = getFilesDir()
     (domain "file"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="napstop_db/"/>
        <!-- T21 §13 + review #3: permission and screen 0 flags stay on this phone. -->
        <exclude domain="sharedpref" path="napstop_permissions.xml"/>
        <exclude domain="sharedpref" path="napstop_onboarding.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="napstop_db/"/>
        <!-- T21 §13 + review #3: permission and screen 0 flags stay on this phone. -->
        <exclude domain="sharedpref" path="napstop_permissions.xml"/>
        <exclude domain="sharedpref" path="napstop_onboarding.xml"/>
    </device-transfer>
</data-extraction-rules>
